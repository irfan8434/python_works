def check_room_availability(room_available, is_vip, member_years):
    if not room_available:
        return "No rooms available"

    if is_vip:
        return "Offer complimentary upgrade"

    elif member_years >= 5:
        return "Offer discount"

    else:
        return "Standard price"


result = check_room_availability(
    room_available=True,
    is_vip=False,
    member_years=6
)

print(result)


