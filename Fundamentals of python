#Python Dynamic Inference, Dynamic Typing & Strong Typing with GST Calculation

fee = 45000

# Dynamic inference
print(type(fee))

# GST as numeric value
gst = 0.18

gst_amount = fee * gst
total_fee = fee + gst_amount

print("GST Amount:", gst_amount)
print("Total Fee:", total_fee)

# Dynamic typing
